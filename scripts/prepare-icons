#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BRAND="$ROOT/crates/app/assets/brand"
SOURCE="$BRAND/Dalan.icon/Assets/Dalan New Transparent.png"
command -v sips >/dev/null 2>&1 || { echo 'Icon preparation needs macOS sips' >&2; exit 1; }
command -v iconutil >/dev/null 2>&1 || { echo 'Icon preparation needs macOS iconutil' >&2; exit 1; }
STAGING=$(mktemp -d "${TMPDIR:-/tmp}/dalan-iconset.XXXXXX")
trap 'rm -rf "$STAGING"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir -p "$STAGING/Dalan.iconset"
python3 "$ROOT/scripts/compose_icon.py" "$SOURCE" "$STAGING/dalan.png"
for spec in '16 16' '16@2x 32' '32 32' '32@2x 64' '128 128' '128@2x 256' '256 256' '256@2x 512' '512 512' '512@2x 1024'; do
    set -- $spec
    name=$1
    dimension=$2
    base=${name%@2x}
    if [ "$base" != "$name" ]; then filename="icon_${base}x${base}@2x.png"; else filename="icon_${name}x${name}.png"; fi
    sips -z "$dimension" "$dimension" "$STAGING/dalan.png" --out "$STAGING/Dalan.iconset/$filename" >/dev/null
done
iconutil -c icns "$STAGING/Dalan.iconset" -o "$STAGING/Dalan.icns"
cp "$STAGING/dalan.png" "$BRAND/dalan.png"
cp "$STAGING/Dalan.icns" "$BRAND/Dalan.icns"
printf 'Updated %s/dalan.png and Dalan.icns from the supplied artwork\n' "$BRAND"
