#!/usr/bin/env python3
"""Explicit local-JDK fixture check. Does not discover Java, download or contact DBs."""
import argparse
import json
from pathlib import Path
import subprocess
import tempfile

parser = argparse.ArgumentParser()
parser.add_argument("--jdk", required=True, help="Absolute JDK home; Java 17+ required")
args = parser.parse_args()
home = Path(args.jdk)
if not home.is_absolute():
    raise SystemExit("JDK must be an absolute path")
root = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix="dalan-java-fixture-") as directory:
    folder = Path(directory)
    bridge = root / "crates/drivers/jvm/DalanJdbcBridge.java"
    fixture = root / "scripts/tests/jdbc/FixtureDriver.java"
    subprocess.run([str(home / "bin/javac"), "-d", str(folder), str(bridge), str(fixture)], check=True, timeout=30)
    jar = folder / "fixture.jar"
    subprocess.run([str(home / "bin/jar"), "cf", str(jar), "-C", str(folder), "FixtureDriver.class"], check=True, timeout=30)
    request = {"op": "test", "driver_class": "FixtureDriver", "jars": [str(jar)], "url": "jdbc:fixture:local", "user": "fixture", "password": "secret", "connect_timeout": 1, "timeout": 1}
    result = subprocess.run([str(home / "bin/java"), "-Xmx256m", str(bridge)], input=json.dumps(request), text=True, capture_output=True, check=True, timeout=30)
    response = json.loads(result.stdout)
    assert response["ok"] and response["report"]["server_version"] == "fixture-17"
    assert "secret" not in result.stdout and not result.stderr
    request["password"] = "wrong"
    result = subprocess.run([str(home / "bin/java"), "-Xmx256m", str(bridge)], input=json.dumps(request), text=True, capture_output=True, check=True, timeout=30)
    response = json.loads(result.stdout)
    assert not response["ok"] and response["errorcategory"] == "authentication"
    assert "wrong" not in result.stdout and "secret" not in result.stdout and not result.stderr
print("Java bridge compile/source launch, JDBC class loading and output redaction: PASS")
